{
  "expo": {
    "name": "Nutraining",
    "slug": "nutraining-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/nutraining-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#234B3E",
        "foregroundImage": "./assets/nutraining-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ryanpierredev.nutrainingmobile",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para seu perfil no Nutraining.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-system-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "5d036e55-3f79-4b3b-8b47-6807529bfd4a"
      }
    },
    "scheme": "nutraining"
  }
}
